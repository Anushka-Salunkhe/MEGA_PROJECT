# TruthLens AI Configuration
# ===========================

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL with automatic resilient SQLite fallback)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/truthlens

# Inference Provider Architecture (PHASE 4)
MODEL_PROVIDER=local
HF_API_ENABLED=false
HF_API_TOKEN=

# Model Architecture Configuration
DEFAULT_ENGINE_VERSION=v2
ENABLE_SHAP=true
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50
