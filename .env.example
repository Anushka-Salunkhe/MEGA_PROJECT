# TruthLens AI — Environment Variables & API Configuration
# ==========================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL with automatic resilient SQLite fallback)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/truthlens

# Inference Provider Architecture
MODEL_PROVIDER=local
HF_API_ENABLED=false
HF_API_TOKEN=

# Model Architecture Configuration
DEFAULT_ENGINE_VERSION=v2
ENABLE_SHAP=true
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

# External Fact-Checking & Knowledge APIs (Section 9)
GOOGLE_FACT_CHECK_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GDELT_ENABLED=true
FACT_CHECK_TIMEOUT_SECONDS=5
